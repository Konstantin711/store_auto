# ============================================================
# LOCATOR PROPERTIES
# ============================================================

#  --- first matching element ---
#  - locator.first


#  --- last matching element ---
#  - locator.last


#  --- page where locator belongs ---
#  - locator.page


#  --- iframe content ---
#  - locator.content_frame


#  --- only visible matching elements ---
#  - locator.visible


#  --- locator description ---
#  - locator.description()


# ============================================================
# DEPRECATED / DISCOURAGED
# ============================================================

#  --- element_handle ---
#  discouraged - prefer Locator
#
#  - locator.element_handle()


#  --- element_handles ---
#  discouraged - prefer Locator
#
#  - locator.element_handles()


#  --- type ---
#  deprecated
#
#  DON'T:
#  - locator.type("Hello")
#
#  USE:
#  - locator.fill("Hello")
#
#  or if typing character by character is required:
#  - locator.press_sequentially("Hello")


